<Window x:Class="PhoneFiles.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PhoneFiles.Desktop"
        Title="phoneFiles — 手机本地数据归档助手" Height="640" Width="1000"
        MinHeight="480" MinWidth="760">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type local:NodeRow}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayText}" />
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: connect toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="RefreshDevicesButton" Content="刷新设备" Width="90" Click="RefreshDevicesButton_Click" DockPanel.Dock="Left" />
            <ComboBox x:Name="DeviceCombo" Margin="8,0,0,0" Height="28" DockPanel.Dock="Left" Width="320"
                      DisplayMemberPath="DisplayName" />
            <Button x:Name="ConnectButton" Content="连接" Width="70" Margin="8,0,0,0" Click="ConnectButton_Click" DockPanel.Dock="Left" />
            <TextBlock x:Name="StatusText" Text="未连接" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="#555" DockPanel.Dock="Left" />
        </DockPanel>

        <!-- Row 1: volume selector + context -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="存储卷：" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <ComboBox x:Name="VolumeCombo" Margin="6,0,0,0" Width="260" Height="26"
                      DisplayMemberPath="DisplayName" SelectionChanged="VolumeCombo_SelectionChanged" DockPanel.Dock="Left" />
            <TextBlock Text="ROM：" VerticalAlignment="Center" Margin="16,0,0,0" DockPanel.Dock="Left" />
            <TextBox x:Name="RomBox" Text="miui" Width="90" Height="26" Margin="6,0,0,0" DockPanel.Dock="Left" VerticalContentAlignment="Center" />
            <TextBlock Text="SDK：" VerticalAlignment="Center" Margin="12,0,0,0" DockPanel.Dock="Left" />
            <TextBox x:Name="SdkBox" Text="31" Width="50" Height="26" Margin="6,0,0,0" DockPanel.Dock="Left" VerticalContentAlignment="Center" />
            <Button x:Name="LoadButton" Content="载入目录" Width="90" Margin="16,0,0,0" Click="LoadButton_Click" DockPanel.Dock="Left" />
        </DockPanel>

        <!-- Row 2: main split: tree + detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="TreeView" Grid.Column="0" Margin="0,0,8,0" SelectedItemChanged="TreeView_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <EventSetter Event="Expanded" Handler="TreeView_OnExpanding" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel" Margin="8,0,0,0">
                    <TextBlock Text="节点详情" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                    <TextBlock x:Name="DetailName" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock x:Name="DetailLabel" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock x:Name="DetailMeta" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock x:Name="DetailAccess" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#8B0000" />
                    <Button x:Name="ArchiveSelectedButton" Content="归档选中目录" Width="140" Height="30"
                            HorizontalAlignment="Left" Click="ArchiveSelectedButton_Click" IsEnabled="False" />
                    <TextBlock Text="说明：受限目录（可见不可读）不会提供归档。" FontSize="11" Foreground="#777"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Row 3: archive progress -->
        <StackPanel Grid.Row="3" Margin="0,8,0,4">
            <ProgressBar x:Name="ArchiveProgress" Height="14" Minimum="0" Maximum="100" Value="0" />
            <TextBlock x:Name="ArchiveStatus" Text="就绪" Margin="0,4,0,0" Foreground="#555" />
        </StackPanel>

        <!-- Row 4: log -->
        <TextBox x:Name="LogBox" Grid.Row="4" Height="96" AcceptsReturn="True" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
    </Grid>
</Window>
